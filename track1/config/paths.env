# shellcheck shell=bash disable=SC2034
# Track 1 路徑設定（Phase 1 Spec v1.2）——所有腳本都會先讀這個檔。
# 對齊實際資料夾：~/mva-hackathon/{repo, gated-data, work, ...}
#
# 想改位置（例如參考資源放外接 SSD）：不要改這個檔，改 config/local.env（不進 git），例如
#   RES=/Volumes/MVA-SSD/resources
# 也可以在執行前 export 同名變數覆蓋。這裡每一行都是「沒設定時才用的預設值」。
# 優先順序：執行前 export 的變數 > config/local.env > 這個檔。

: "${MVA_ROOT:=$HOME/mva-hackathon}"
: "${DATA:=$MVA_ROOT/gated-data}"            # 比賽原始資料：不進 git、不備份、比賽後刪
: "${WORK:=$MVA_ROOT/work/track1}"           # 中間檔，含逐位點基因型：比賽後刪
: "${RES:=$MVA_ROOT/resources}"              # 公開參考資源（FASTA、VEP cache、Exomiser、ClinVar）：可保留
: "${RESULTS:=$MVA_ROOT/results/track1}"     # 提交 CSV、HPO 清單、基因名次：可保留，但不進 repo

: "${REF:=$RES/GRCh38.nochr.fa.gz}"          # bgzip + faidx；染色體名稱沒有 chr，和 VCF 一致
: "${REF_PLAIN:=$RES/GRCh38.nochr.fa}"       # 未壓縮版，SpliceAI 用
: "${VEP_VERSION:=116}"                      # VEP 程式版本 = cache 版本 = GTF 的 Ensembl release
: "${VEP_CACHE:=$RES/vep_cache}"
: "${CLINVAR:=$RES/clinvar.vcf.gz}"
: "${GTF:=$RES/Homo_sapiens.GRCh38.${VEP_VERSION}.gtf.gz}"
: "${PANEL_FLANK:=10000}"                    # MVA 基因本體前後各延伸幾 bp
: "${PANEL_BED:=$RES/panel_mva_${PANEL_FLANK}bp.bed}"
: "${HPO_OBO:=$RES/hp.obo}"
: "${SCORER:=$RES/scorer/evaluation.py}"     # 官方評分程式（02 下載）
: "${EXOMISER_VERSION:=15.1.0}"
: "${EXOMISER_DATA_VERSION:=2602}"
: "${EXOMISER_DIR:=$RES/exomiser/exomiser-cli-$EXOMISER_VERSION}"
: "${EXOMISER_DATA:=$RES/exomiser/data}"

: "${HF_DATASET:=SageBio/mva-hackathon-2026-data}"
: "${HF_SPACE:=SageBio/rare-disease-real-kid-mva-hackathon-2026}"
: "${PROBAND:=PROBAND01}"

: "${THREADS:=4}"                            # bcftools 壓縮執行緒
: "${VEP_FORK:=4}"                           # 8 GB 記憶體的 Mac 改 2（00_check.sh 會建議）
: "${JAVA_XMX:=10g}"                         # Exomiser 記憶體上限；8 GB 的 Mac 改 6g
: "${SPLICEAI_DIST:=500}"                    # SpliceAI -D：變異前後幾 bp 內找剪接位點變化
